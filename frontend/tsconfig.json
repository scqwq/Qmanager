{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "isolatedModules": true, "skipLibCheck": true,
    "resolveJsonModule": true, "esModuleInterop": true, "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
